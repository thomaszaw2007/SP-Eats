# Copy this file to .env.dev and .env.test. Use a different database in each.
# Local PostgreSQL URL format: postgresql://<user>:<password>@localhost:5432/<database>
DATABASE_URL=

# Use 3000 for .env.dev and 3001 for .env.test (Playwright expects 3001).
PORT=3000

# Set to the exact dedicated database name before resetting or reloading sample data.
SP_EATS_RESET_DATABASE=

# Optional. Generate a separate, random key of at least 32 characters for review moderation.
ADMIN_ACCESS_TOKEN=
